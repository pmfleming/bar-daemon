[Unit]
Description=Privileged battery charging and hibernate delay helper
Documentation=https://github.com/pmfleming/bar-daemon

[Service]
Type=dbus
BusName=org.laufan.BarBatteryHelper
ExecStart=@out@/bin/bar-battery-helper
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Keep this shared systemd directory when the helper stops.
RuntimeDirectory=systemd/sleep.conf.d
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=/sys/class/power_supply /run/systemd/sleep.conf.d
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
