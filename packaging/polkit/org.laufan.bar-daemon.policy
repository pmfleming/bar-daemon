<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>bar-daemon</vendor>
  <vendor_url>https://github.com/pmfleming/bar-daemon</vendor_url>
  <action id="org.laufan.bar-daemon.set-battery-thresholds">
    <description>Set ThinkPad battery charge thresholds</description>
    <message>Authentication is required to change battery charge thresholds.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
