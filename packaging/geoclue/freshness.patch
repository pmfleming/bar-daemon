 }
 
+void
+gclue_locator_refresh_since (GClueLocator *locator, guint64 minimum_timestamp)
+{
+        GList *node;
+        for (node = locator->priv->active_sources; node != NULL; node = node->next) {
+                GClueLocationSource *source = node->data;
+                if (GCLUE_IS_WIFI (source))
+                        gclue_wifi_refresh_since (GCLUE_WIFI (source), minimum_timestamp);
+                else if (GCLUE_IS_WEB_SOURCE (source))
+                        gclue_web_source_refresh (GCLUE_WEB_SOURCE (source));
+        }
+}
