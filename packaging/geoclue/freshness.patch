+static gboolean
+gclue_service_client_handle_refresh_since (GClueDBusClient *client,
+                                            GDBusMethodInvocation *invocation,
+                                            guint64 minimum_timestamp)
+{
+        GClueServiceClientPrivate *priv = GCLUE_SERVICE_CLIENT (client)->priv;
+        const char *sender = g_dbus_method_invocation_get_sender (invocation);
+        guint64 now = g_get_real_time () / G_USEC_PER_SEC;
+
+        if (g_strcmp0 (sender, gclue_client_info_get_bus_name (priv->client_info)) != 0 ||
+            !gclue_dbus_client_get_active (client) || priv->locator == NULL ||
+            priv->refreshed || minimum_timestamp > now) {
+                g_dbus_method_invocation_return_error_literal (invocation,
+                        G_DBUS_ERROR, G_DBUS_ERROR_ACCESS_DENIED,
+                        "Revalidation requires an active owning client, once, without a future timestamp");
+                return TRUE;
+        }
+        priv->refreshed = TRUE;
+        gclue_locator_refresh_since (priv->locator, minimum_timestamp);
+        gclue_dbus_client_complete_refresh_since (client, invocation);
+        return TRUE;
+}
