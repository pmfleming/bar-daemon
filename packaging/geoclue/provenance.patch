 #include <glib.h>
 #include <json-glib/json-glib.h>
 #include <string.h>
@@ -337,6 +338,20 @@
         return TRUE;
 }
 
+/* Do not let JSON-GLib/GObject default invalid coordinates to zero and then
+ * attach trusted IP provenance to that fabricated position. */
+static gboolean
+read_number (JsonObject *object, const char *name, gdouble *value)
+{
+        JsonNode *node = json_object_get_member (object, name);
+        if (node == NULL || !JSON_NODE_HOLDS_VALUE (node) ||
+            (json_node_get_value_type (node) != G_TYPE_DOUBLE &&
+             json_node_get_value_type (node) != G_TYPE_INT64))
+                return FALSE;
+        *value = json_node_get_double (node);
+        return isfinite (*value);
+}
+
 GClueLocation *
 gclue_mozilla_parse_response (const char *json,
                               const char *location_description,
@@ -348,6 +363,15 @@
         g_autofree char *desc_new = NULL;
         GClueLocation *location;
         gdouble latitude, longitude, accuracy;
+        /* This argument is the request builder's internal input-kind token,
+         * not a provider-supplied or public Location.Description string. */
+        guint source_kind = 0;
+        if (g_strcmp0 (location_description, "GeoIP") == 0)
+                source_kind = 1;
+        else if (g_strcmp0 (location_description, "WiFi") == 0 ||
+                 g_strcmp0 (location_description, "3GPP") == 0 ||
+                 g_strcmp0 (location_description, "3GPP + WiFi") == 0)
+                source_kind = 2;
 
         parser = json_parser_new ();
 
@@ -355,6 +379,8 @@
                 return NULL;
 
         node = json_parser_get_root (parser);
+        if (node == NULL || !JSON_NODE_HOLDS_OBJECT (node))
+                goto invalid_location;
         object = json_node_get_object (node);
 
         if (parse_server_error (object, error))
@@ -363,7 +389,14 @@
         if (json_object_has_member (object, "fallback")) {
                 const char *fallback;
 
-                fallback = json_object_get_string_member (object, "fallback");
+                JsonNode *fallback_node = json_object_get_member (object, "fallback");
+                fallback = JSON_NODE_HOLDS_VALUE (fallback_node) &&
+                           json_node_get_value_type (fallback_node) == G_TYPE_STRING
+                        ? json_node_get_string (fallback_node) : NULL;
+                /* Only explicit ipf is positive evidence of IP fallback.
+                 * An unrecognised/null fallback must not inherit IP trust. */
+                source_kind = g_strcmp0 (fallback, "ipf") == 0 ? 1 :
+                              g_strcmp0 (fallback, "lacf") == 0 ? 2 : 0;
                 if (fallback && strlen (fallback)) {
                         desc_new = g_strdup_printf ("%s fallback (from %s data)",
                                                     fallback, location_description);
@@ -371,16 +404,27 @@
                 }
         }
 
-        loc_object = json_object_get_object_member (object, "location");
-        latitude = json_object_get_double_member (loc_object, "lat");
-        longitude = json_object_get_double_member (loc_object, "lng");
-
-        accuracy = json_object_get_double_member (object, "accuracy");
+        node = json_object_get_member (object, "location");
+        if (node == NULL || !JSON_NODE_HOLDS_OBJECT (node))
+                goto invalid_location;
+        loc_object = json_node_get_object (node);
+        if (!read_number (loc_object, "lat", &latitude) ||
+            !read_number (loc_object, "lng", &longitude) ||
+            !read_number (object, "accuracy", &accuracy) ||
+            latitude < -90 || latitude > 90 ||
+            longitude < -180 || longitude > 180 || accuracy < 0)
+                goto invalid_location;
 
         location = gclue_location_new (latitude, longitude, accuracy,
                                        location_description);
+        g_object_set (location, "source-kind", source_kind, NULL);
 
         return location;
+
+invalid_location:
+        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                             "Invalid geolocation coordinates or accuracy");
+        return NULL;
 }
 
