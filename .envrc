# Never let direnv recreate private local-project deployment pins.
watch_file ../daemon-framework/flake.nix ../shelllist-hyprland/flake.nix
use flake . --no-write-lock-file \
  --override-input daemonFramework "git+file://$(realpath ../daemon-framework)" \
  --override-input hyprlandIpc "git+file://$(realpath ../shelllist-hyprland)"
